PORT=3000
APP_URL=http://localhost:3000
ADMIN_PATH=/admin
SUPABASE_URL=https://your-project.supabase.co
# W panelu Supabase: Connect lub Settings -> API Keys.
# Użyj aktualnych kluczy Publishable i Secret. Nie commituj pliku .env.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Opcjonalnie: kompatybilność ze starszymi kluczami anon/service_role.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
EVENT_CAPACITY=12
NODE_ENV=development
